.variables
    $aux_offset_L %0
    $aux_offset_H %0
    $low_byte %0
    $high_byte %0
    $high_next %0

    $instruction %0
    $opcode %0

    $p_stack_offset %0
    $end_addr_L %0
    $end_addr_H %0

    $pc_set %0
    $pc_start_addr_L %0
    $pc_start_addr_H %0

    $RAM_offset_L %0
    $RAM_offset_H %0

    $var_offset_L %0
    $var_offset_H %0

    $l_offset_L %0
    $l_offset_H %0
    $unL_offset_L %0
    $unL_offset_H %0
    $s_offset_L %0
    $s_offset_H %0
    $unS_offset_L %0
    $unS_offset_H %0

    $l_size_L %0
    $l_size_H %0
    $unL_size_L %0
    $unL_size_H %0
    $s_size_L %0
    $s_size_H %0
    $unS_size_L %0
    $unS_size_H %0
    $var_size_L %0
    $var_size_H %0

    $l_start_addr_L %0
    $l_start_addr_H %0
    $unL_start_addr_L %0
    $unL_start_addr_H %0
    $s_start_addr_L %0
    $s_start_addr_H %0
    $unS_start_addr_L %0
    $unS_start_addr_H %0

    $i %0
    $j %0

    ; IO Setter byte low        &DA58
    ; IO Setter byte high       &DA59
    ; IO ready flag             &DA5A
    ; p_stack                   &FF85
    ; RAM final address         &DA57
    ; Variable Memory           &D858

.data
_Decrement_Address
    ; Decrements the address stored in registers C (low) and D (high)
    DECR @C
    CMPI @C %255
    JZS #dec_high
    RSR

    #dec_high
        DECR @D
        RSR

_Increment_Address
    ; Increments the address stored in registers C (low) and D (high)
    INCR @C
    JZS #inc_high
    RSR

    #inc_high
        INCR @D
        RSR

_Increment_Aux_Address
    ; Shortcut subroutine to increment aux mem offset address
    LDFM @C $aux_offset_L
    LDFM @D $aux_offset_H
    JSR _Increment_Address
    STOR $aux_offset_L @C
    STOR $aux_offset_H @D
    RSR

_Grab_Low
    ; Load the aux mem offset address into the setter bytes of the IO
    COPM &DA58 $aux_offset_L
    COPM &DA59 $aux_offset_H
    STRI &DA5A %1 ; Sets the IO flag to let IO know to perform operations

    ; Get the lower byte value stored at the aux mem offset address
    COPM $low_byte &DA5B
    RSR

_Grab_High
    ; Load the aux mem offset address into the setter bytes of the IO
    COPM &DA58 $aux_offset_L
    COPM &DA59 $aux_offset_H
    STRI &DA5A %1

    ; Get the higher byte stores at the aux mem offset address
    COPM $high_byte &DA5C
    RSR

_Split_Bytes
    ; Load the aux mem offset address into the setter bytes of the IO
    COPM &DA58 $aux_offset_L
    COPM &DA59 $aux_offset_H
    STRI &DA5A %1

    ; Get the two bytes stored at the aux mem offset address
    COPM $low_byte &DA5B
    COPM $high_byte &DA5C
    JSR _Increment_Aux_Address
    RSR
    
_Grab_Byte
    ; Grabs the low byte if high_next is false, else grabs high byte
    ; In this subroutine, output is stored in low_byte
    LDFM @A $high_next
    JZS #grab_low

    ; Grab high byte
    JSR _Grab_High
    STRI $high_next %0
    COPM $low_byte $high_byte
    JSR _Increment_Aux_Address
    RSR

    #grab_low
        JSR _Grab_Low
        STRI $high_next %1
        RSR

_Grab_Word
    ; Grabs a word from aux mem offset address
    LDFM @A $high_next
    JZS #split

    ; The bytes to grab are in different addresses
    JSR _Grab_High
    JSR _Increment_Aux_Address
    JSR _Grab_Low
    RSR

    #split
        JSR _Split_Bytes
        RSR

_Check_Opcode_Type
    ; Given the opcode in $opcode, return a certain depending on what kind of encoding it is in register B
    LDFM @A $opcode
    LDFI @B %0

    ; If label jump opcode, (0x21, 0x24 - 0x2B)
    #lj_check
        CMPI @A %33
        JZS #is_lj

        CMPI @A %44
        JCS #sj_check
        CMPI @A %24
        JCS #is_lj

        JMP #sj_check

    #is_lj
        LDFI @B %1
        RSR

    ; If subroutine jump (0x22)
    #sj_check
        CMPI @A %34
        JZC #reg_op1_check

    #is_sj
        LDFI @B %2
        RSR

    ; If reg as op 1, (0x01 - 0x03, 0x05, 0x07, 0x08, 0x0E - 0x19, 0x1B, 0x1D, 0x1E, 0x38, 0x3C)
    #reg_op1_check
        CMPI @A %1
        JZS #is_reg_op1
        CMPI @A %2
        JZS #is_reg_op1
        CMPI @A %3
        JZS #is_reg_op1
        CMPI @A %5
        JZS #is_reg_op1
        CMPI @A %7
        JZS #is_reg_op1
        CMPI @A %8
        JZS #is_reg_op1
        CMPI @A %27
        JZS #is_reg_op1
        CMPI @A %29
        JZS #is_reg_op1
        CMPI @A %30
        JZS #is_reg_op1
        CMPI @A %56
        JZS #is_reg_op1
        CMPI @A %60
        JZS #is_reg_op1

        CMPI @A %26
        JCS #mem_op1_check
        CMPI @A %14
        JCS #is_reg_op1

        JMP #mem_op1_check

    #is_reg_op1
        LDFI @B %3
        JMP #reg_op2_check

    ; If mem as op 1, (0x04, 0x06, 0x09, 0x1A, 0x1C, 0x1F, 0x20, 0x39 - 0x3B, 0x3D - 0x40, 0x43 - 0x46)
    #mem_op1_check
        CMPI @A %4
        JZS #is_mem_op1
        CMPI @A %6
        JZS #is_mem_op1
        CMPI @A %9
        JZS #is_mem_op1
        CMPI @A %26
        JZS #is_mem_op1
        CMPI @A %28
        JZS #is_mem_op1
        CMPI @A %31
        JZS #is_mem_op1
        CMPI @A %32
        JZS #is_mem_op1

        CMPI @A %71
        JCS #reg_op2_check
        CMPI @A %67
        JCS #is_mem_op1
        CMPI @A %65
        JCS #reg_op2_check
        CMPI @A %61
        JCS #is_mem_op1
        CMPI @A %60
        JCS #reg_op2_check
        CMPI @A %57
        JCS #is_mem_op1

        JMP #reg_op2_check

    #is_mem_op1
        LDFI @B %4

    ; If reg as op 2, (0x03, 0x04, 0x05, 0x0E, 0x0F, 0x10, 0x12 - 0x16, 0x39)
    #reg_op2_check
        CMPI @A %3
        JZS #is_reg_op2
        CMPI @A %4
        JZS #is_reg_op2
        CMPI @A %5
        JZS #is_reg_op2
        CMPI @A %14
        JZS #is_reg_op2
        CMPI @A %15
        JZS #is_reg_op2
        CMPI @A %16
        JZS #is_reg_op2
        CMPI @A %57
        JZS #is_reg_op2

        CMPI @A %23
        JCS #mem_op2_check
        CMPI @A %18
        JCS #is_reg_op2

        JMP #mem_op2_check

    #is_reg_op2
        LDFI @A %2
        ADD @B @A
        RSR

    ; If mem as op 2, (0x01, 0x06, 0x17, 0x38, 0x3A, 0x3C, 0x43, 0x44)
    #mem_op2_check
        CMPI @A %1
        JZS #is_mem_op2
        CMPI @A %6
        JZS #is_mem_op2
        CMPI @A %23
        JZS #is_mem_op2
        CMPI @A %56
        JZS #is_mem_op2
        CMPI @A %58
        JZS #is_mem_op2
        CMPI @A %60
        JZS #is_mem_op2
        CMPI @A %67
        JZS #is_mem_op2
        CMPI @A %68
        JZS #is_mem_op2

        JMP #imm_op2_check
    
    #is_mem_op2
        LDFI @A %4
        ADD @B @A 
        RSR

    ; If imm as op 2, (0x02, 0x18, 0x45, 0x46)
    #imm_op2_check
        CMPI @A %2
        JZS #is_imm_op2
        CMPI @A %24
        JZS #is_imm_op2
        CMPI @A %69
        JZS #is_imm_op2
        CMPI @A %70
        JZS #is_imm_op2

        RSR

    #is_imm_op2
        LDFI @A %6
        ADD @B @A 
        RSR

_start
    ; GET THE NUMBER OF VARIABLES 
    ; Get the first address from p_stack
    LDFM @E $p_stack_offset
    LDFI @F %0
    LDFO @A &FF85
    STOR $aux_offset_L @A
    INCR @E 

    LDFO @A &FF85
    STOR $aux_offset_H @A
    INCR @E
    STOR $p_stack_offset @E

    ; Increment given address by 2
    JSR _Increment_Aux_Address
    JSR _Increment_Aux_Address

    ; A word stores the size of var_size
    JSR _Grab_Word
    COPM $var_size_L $low_byte
    COPM $var_size_H $high_byte

    ; Store the first address of actual program in stack
    PSHM $aux_offset_H
    PSHM $aux_offset_L

    ; GET ENDING ADDRESS
    ; Get the second address from p_stack
    LDFM @E $p_stack_offset
    LDFI @F %0
    LDFO @A &FF85
    STOR $end_addr_L @A
    INCR @E

    LDFO @A &FF85
    STOR $end_addr_H @A
    INCR @E
    STOR $p_stack_offset @E

    ; GO TO THE FIRST ADDRESS OF .data SECTION
    #loop_start_1
        LDFM @A $var_size_L
        CMPM @A $i
        JZS #loop_end_1

        JSR _Grab_Word
        JSR _Grab_Byte

        INCM $i
        JMP #loop_start_1
    #loop_end_1

    ; 1ST LOOP TO GET SIZES OF MAPS
    #loop_start_2
        LDFM @A $end_addr_L
        CMPM @A $aux_offset_L
        JZC #loop_check_end

        LDFM @A $end_addr_H
        CMPM @A $aux_offset_H
        JZS #loop_end_2
        
        #loop_check_end
            ; Grab the next instruction
            JSR _Grab_Byte
            COPM $instruction $low_byte

        ; Check if the instruction is a label encoding (0x35, 54)
        #label_check_1
            LDFM @A $instruction 
            CMPI @A %54
            JZC #subr_check_1
            
            INCM $l_size_L
            LDFM @A $l_size_L
            JZC #continue_1
            INCM $l_size_H

        #continue_1
            JMP #loop_start_2
            ;JSR _Grab_Byte
            ;COPM $instruction $low_byte

        ; Check if the instruction is a subroutine encoding (0x41, 65)
        #subr_check_1
            LDFM @A $instruction
            CMPI @A %65
            JZC #op_check_1

            INCM $s_size_L
            LDFM @A $s_size_L
            JZC #continue_2
            INCM $s_size_H

        #continue_2
            JMP #loop_start_2
            ;JSR _Grab_Byte
            ;COPM $instruction $low_byte

        ; Check opcode operands for any possible unL or unS values
        #op_check_1
            COPM $opcode $instruction

            ; Check what kind of opcode it is
            JSR _Check_Opcode_Type
            
            #label_value
                CMPI @B %1
                JZC #subr_value

                JSR _Grab_Word
                INCM $unL_size_L
                LDFM @A $unL_size_L
                JZC #loop_start_2
                INCM $unL_size_H
                JMP #loop_start_2

            #subr_value
                CMPI @B %2
                JZC #r_value

                JSR _Grab_Word
                INCM $unS_size_L
                LDFM @A $unS_size_L
                JZC #loop_start_2
                INCM $unS_size_H
                JMP #loop_start_2

            #r_value
                CMPI @B %3
                JZC #m_value

                JSR _Grab_Byte
                JMP #loop_start_2

            #m_value
                CMPI @B %4
                JZC #rr_value

                JSR _Grab_Byte
                JSR _Grab_Word
                JMP #loop_start_2

            #rr_value
                CMPI @B %5
                JZC #mr_value

                JSR _Grab_Word
                JMP #loop_start_2

            #mr_value
                CMPI @B %6
                JZC #rm_value

                JSR _Grab_Word
                JSR _Grab_Word
                JMP #loop_start_2

            #rm_value
                CMPI @B %7
                JZC #mm_value
                
                JSR _Grab_Word
                JSR _Grab_Word
                JMP #loop_start_2

            #mm_value
                CMPI @B %8
                JZC #ri_value

                JSR _Grab_Word
                JSR _Grab_Word
                JSR _Grab_Word
                JMP #loop_start_2

            #ri_value
                CMPI @B %9
                JZC #mi_value

                JSR _Grab_Word
                JMP #loop_start_2

            #mi_value
                CMPI @B %10
                JZC #loop_start_2

                JSR _Grab_Word
                JSR _Grab_Word
                JMP #loop_start_2
    #loop_end_2

    ; ALLOCATE SECTION OF MEMORY FOR THE MAPS AT THE END OF RAM
    ; Allocate l_size * 2 (2 bytes per label to store is address)
    LDFI @C %87 ; (0x57)
    LDFI @D %218 ; (0xDA)
    #l_alloc_loop_start
        LDFM @A $l_size_L
        JZC #loop_check_end_2
        LDFM @A $l_size_H
        JZS #l_alloc_loop_end

        #loop_check_end_2
            JSR _Decrement_Address
            JSR _Decrement_Address

            DECM $l_size_L
            LDFM @A $l_size_L
            CMPI @A %255
            JZC #l_alloc_loop_start
            DECM $l_size_H
            JMP #l_alloc_loop_start
    #l_alloc_loop_end
    STOR $l_start_addr_L @C
    STOR $l_start_addr_H @D

    ; Allocate unL_size * 4 (2 bytes to store id, 2 to store address)
    #unL_alloc_loop_start
        LDFM @A $unL_size_L
        JZC #loop_check_end_3
        LDFM @A $unL_size_H
        JZS #unL_alloc_loop_end

        #loop_check_end_3
            JSR _Decrement_Address
            JSR _Decrement_Address
            JSR _Decrement_Address
            JSR _Decrement_Address

            DECM $unL_size_L
            LDFM @A $unL_size_L
            CMPI @A %255
            JZC #unL_alloc_loop_start
            DECM $unL_size_H
            JMP #unL_alloc_loop_start
    #unL_alloc_loop_end
    STOR $unL_start_addr_L @C
    STOR $unL_start_addr_H @D

    ; Allocate s_size * 2 (2 bytes to store its address)
    #s_alloc_loop_start
        LDFM @A $s_size_L
        JZC #loop_check_end_4
        LDFM @A $s_size_H
        JZS #s_alloc_loop_end

        #loop_check_end_4
            JSR _Decrement_Address
            JSR _Decrement_Address

            DECM $s_size_L
            LDFM @A $s_size_L
            CMPI @A %255
            JZC #s_alloc_loop_start
            DECM $s_size_H
            JMP #s_alloc_loop_start
    #s_alloc_loop_end
    STOR $s_start_addr_L @C
    STOR $s_start_addr_H @D

    ; Allocate unS_size * 4  (2 bytes to store its address, 2 bytes to store id)
    #unS_alloc_loop_start
        LDFM @A $unS_size_L
        JZC #loop_check_end_5
        LDFM @A $unS_size_H
        JZS #unS_alloc_loop_end

        #loop_check_end_5
            JSR _Decrement_Address
            JSR _Decrement_Address
            JSR _Decrement_Address
            JSR _Decrement_Address

            DECM $unS_size_L
            LDFM @A $unS_size_L
            CMPI @A %255
            JZC #unS_alloc_loop_start
            DECM $unS_size_H
            JMP #unS_alloc_loop_start
    #unS_alloc_loop_end
    STOR $unS_start_addr_L @C
    STOR $unS_start_addr_H @D

    ; Go back to first address of variables to start second loop
    PULR @A
    STOR $aux_offset_L @A
    PULR @A
    STOR $aux_offset_H @A
    STRI $high_next %0

    ; 2ND LOOP TO PARSE CONTENT
    #loop_start_3
        LDFM @A $end_addr_L
        CMPM @A $aux_offset_L
        JZC #loop_check_end_6

        LDFM @A $end_addr_H
        CMPM @A $aux_offset_H
        JZS #loop_end_3

        #loop_check_end_6
            ; Parse a variable if var_count != 0
            LDFM @A $var_size_L
            JZC #get_var_value

            LDFM @A $var_size_H
            JZS #instruction_grab

        #get_var_value
            JSR _Grab_Word
            JSR _Grab_Byte

            LDFM @E $var_offset_L
            LDFM @F $var_offset_H
            LDFI @C %0
            LDFI @D %0
            COPO &D858 $low_byte
            
            INCM $var_offset_L
            LDFM @A $var_offset_L
            JZC #var_count_minus
            INCM $var_offset_H

            #var_count_minus
                LDFM @A $var_size_L
                JZC #minus_L
                DECM $var_size_H

            #minus_L
                DECM $var_size_L

            JMP #loop_start_3
            
        #instruction_grab
            JSR _Grab_Byte
            COPM $instruction $low_byte

        ; Check if it is a halt instruction (0x35)
        #halt_check
            LDFM @A $instruction
            CMPI @A %53
            JZC #label_check_2

            LDFM @A $pc_set
            JZS #write_halt_to_memory
            COPM $pc_start_addr_L $RAM_offset_L
            COPM $pc_start_addr_H $RAM_offset_H
            STRI $pc_set %1

            #write_halt_to_memory
                LDFI @C %0
                LDFI @D %0
                LDFM @E $RAM_offset_L
                LDFM @F $RAM_offset_H
                COPO &0100 $instruction
                LDFM @C $RAM_offset_L
                LDFM @D $RAM_offset_H
                JSR _Increment_Address
            
            JMP #loop_start_3

        ; Check if the is a label encoding (0x36)
        #label_check_2
            CMPI @A %54
            JZC #subr_check_2
            
            JSR _Grab_Word
            PSHM $high_byte
            PSHM $low_byte

            LDFI @C %0
            LDFI @D %0
            LDFM @E $l_start_addr_L
            LDFM @F $l_start_addr_H
            LDFM @B $l_offset_L
            ADD @E @B
            JOC #second_add
            INCR @F

            #second_add
            LDFM @B $l_offset_H
            ADD @F @B

            #addr_store
                COPO &0000 $RAM_offset_L
                INCR @E 
                JZC #second_addr_store
                INCR @F
            
            #second_addr_store
                COPO &0000 $RAM_offset_H
                INCM $l_offset_L
                LDFM @A $l_offset_L
                JZS #second_inc
                INCM $l_offset_H

            #second_inc
                INCM $l_offset_L
                LDFM @A $l_offset_L
                JZS #loop_start_4
                INCM $l_offset_H

            STRI $i %0
            STRI $j %0
            #loop_start_4
                LDFM @A $s_start_addr_L
                CMPM @A $i 
                JZC #check_label
                LDFM @A $s_start_addr_H
                CMPM @A $j
                JZS #loop_end_4

                #check_label
                    LDFM @E $unL_start_addr_L
                    LDFM @F $unL_start_addr_H
                    LDFM @A $i

                    ADD @E @A
                    JZC #add_1
                    INCR @F 
                    #add_1
                    LDFM @A $j
                    ADD @F @A

                #get_element_1
                    LDFO @A &0000
                    INCR @E
                    JZC #get_element_2
                    INCR @F

                #get_element_2
                    LDFO @B &0000
                    INCR @E 
                    JZC #compare_id_1
                    INCR @F

                #compare_id_1
                    PULR @C 
                    PULR @D
                    CMPR @A @C
                    JZC #loop_start_4
                    CMPR @B @D
                    JZC #loop_start_4
                    PSHR @C 
                    PSHR @D

                #get_element_3
                    LDFO @A &0000
                    INCR @E
                    JZC #get_element_4
                    INCR @F

                #get_element_4
                    LDFO @B &0000
                    INCR @E 
                    JZC #write_label_to_memory
                    INCR @F

                #write_label_to_memory
                LDFM @G $l_start_addr_L
                LDFM @H $l_start_addr_H
                ADD @C @G 
                JOC #add_2
                INCR @D

                #add_2
                ADD @D @H

                COPO &0100 &0000

                STOR $i @E
                STOR $j @F
                JMP #loop_start_4
            #loop_end_4

            JMP #loop_start_3

        ; Check if the is a subroutine encoding (0x41)
        #subr_check_2
            CMPI @A %65
            JZC #start_check
            
            JSR _Grab_Word
            PSHM $high_byte
            PSHM $low_byte

            LDFI @C %0
            LDFI @D %0
            LDFM @E $s_start_addr_L
            LDFM @F $s_start_addr_H
            LDFM @B $s_offset_L
            ADD @E @B
            JOC #second_add
            INCR @F

            #second_add
            LDFM @B $s_offset_H
            ADD @F @B

            #addr_store
                COPO &0000 $RAM_offset_L
                INCR @E 
                JZC #second_addr_store
                INCR @F
            
            #second_addr_store
                COPO &0000 $RAM_offset_H
                INCM $s_offset_L
                LDFM @A $s_offset_L
                JZS #second_inc
                INCM $s_offset_H

            #second_inc
                INCM $s_offset_L
                LDFM @A $s_offset_L
                JZS #loop_start_5
                INCM $s_offset_H

            STRI $i %0
            STRI $j %0
            #loop_start_5
                LDFI @A $58
                CMPM @A $i 
                JZC #check_label
                LDFM @A %216
                CMPM @A $j
                JZS #loop_end_5

                #check_label
                    LDFM @E $unS_start_addr_L
                    LDFM @F $unS_start_addr_H
                    LDFM @A $i

                    ADD @E @A
                    JZC #add_1
                    INCR @F 
                    #add_1
                    LDFM @A $j
                    ADD @F @A

                #get_element_1
                    LDFO @A &0000
                    INCR @E
                    JZC #get_element_2
                    INCR @F

                #get_element_2
                    LDFO @B &0000
                    INCR @E 
                    JZC #compare_id_1
                    INCR @F

                #compare_id_1
                    PULR @C 
                    PULR @D
                    CMPR @A @C
                    JZC #loop_start_5
                    CMPR @B @D
                    JZC #loop_start_5
                    PSHR @C 
                    PSHR @D

                #get_element_3
                    LDFO @A &0000
                    INCR @E
                    JZC #get_element_4
                    INCR @F

                #get_element_4
                    LDFO @B &0000
                    INCR @E 
                    JZC #write_subr_to_memory
                    INCR @F

                #write_subr_to_memory
                LDFM @G $s_start_addr_L
                LDFM @H $s_start_addr_H
                ADD @C @G 
                JOC #add_2
                INCR @D

                #add_2
                ADD @D @H

                COPO &0100 &0000

                STOR $i @E
                STOR $j @F
                JMP #loop_start_5
            #loop_end_5

            JMP #loop_start_3

        ; Check if it a start encoding (0x37)
        #start_check
            LDFM @A $instruction
            CMPI @A %55
            JZC #pc_set_check

            COPM $pc_start_addr_L $RAM_offset_L
            COPM $pc_start_addr_H $RAM_offset_H
            STRI $pc_set %1
            
            JMP #loop_start_3

        ; Update the start of the program if either a halt or a start instruction has not yet appeared
        #pc_set_check
            LDFM @A $pc_set
            JZC #ins_to_op

            COPM $pc_start_addr_L $RAM_offset_L
            COPM $pc_start_addr_H $RAM_offset_H
            STRI $pc_set %1

        #ins_to_op
            COPM $opcode $instruction

            JSR _Check_Opcode_Type

        #r_value_2
            CMPI @B %3
            JZC #m_value_2
            JSR _Grab_Byte

            LDFI @C %0
            LDFI @D %0
            LDFM @E $RAM_offset_L
            LDFM @F $RAM_offset_H

            COPO &0100 $low_byte
        
            LDFM @C $RAM_offset_L
            LDFM @D $RAM_offset_H
            JSR _Increment_Address

            JMP #loop_start_3

        #m_value_2
            CMPI @B %4
            JZC #rr_value_2

        #rr_value_2
            CMPI @B %5
            JZC #mr_value_2

        #mr_value_2
            CMPI @B %6
            JZC #rm_value_2

        #rm_value_2
            CMPI @B %7
            JZC #mm_value_2

        #mm_value_2
            CMPI @B %8
            JZC #ri_value_2

        #ri_value_2
            CMPI @B %9
            JZC #mi_value_2

        #mi_value_2
            CMPI @B %10
            JZC #loop_start_3
        
    #loop_end_3

    HALT
