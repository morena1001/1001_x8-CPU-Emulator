                CCF
                ADD @C @B
                JOC #add_addr_2_5
                INCR @D

            #add_addr_2_5
                LDFI @B %216
                CCF
                ADD @D @B

            LDFM @E $RAM_offset_L
            LDFM @F $RAM_offset_H
            STOO &0100 @C

            INCR @E 
            JZC #stor_addr_high_5
            INCR @F

            #stor_addr_high_5
                STOO &0100 @D
                LDFR @C @E
                LDFR @D @F
                JSR _Increment_Address

            STOR $RAM_offset_L @C
            STOR $RAM_offset_H @D
        
            #reg_as_op2_5
                JSR _Grab_Byte

                LDFI @C %0
                LDFI @D %0
                LDFM @E $RAM_offset_L
                LDFM @F $RAM_offset_H

                COPO &0100 $low_byte
            
                LDFM @C $RAM_offset_L
                LDFM @D $RAM_offset_H
                JSR _Increment_Address
                STOR $RAM_offset_L @C
                STOR $RAM_offset_H @D

                JMP #loop_start_3
    #loop_end_3

    HALT
