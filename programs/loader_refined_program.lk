            STOR $RAM_offset_H @D
            JMP #loop_start_3

        #mm_value_2
            CMPI @B %8
            JZC #ri_value_2

            JSR _Grab_Byte

            ; Check if instruction is an address encoding
            LDFI @A %66
            CMPM @A $low_byte
            JZC #no_address_3

