.variables
    $aux_offset_L %0
    $aux_offset_H %0
    $low_byte %0
    $high_byte %0
    $high_next %0

    $instruction %0
    $opcode %0

    $p_stack_offset %0
    $end_addr_L %0
    $end_addr_H %0

    $pc_set %0
    $pc_start_addr_L %0
    $pc_start_addr_H %0

    $RAM_offset_L %0
    $RAM_offset_H %0

    $var_offset_L %0
    $var_offset_H %0

    $l_offset_L %0
    $l_offset_H %0
    $unL_offset_L %0
    $unL_offset_H %0
    $s_offset_L %0
    $s_offset_H %0
    $unS_offset_L %0
    $unS_offset_H %0

    $l_size_L %0
    $l_size_H %0
    $unL_size_L %0
    $unL_size_H %0
    $s_size_L %0
    $s_size_H %0
    $unS_size_L %0
    $unS_size_H %0
    $var_size_L %0
    $var_size_H %0

    $l_start_addr_L %0
    $l_start_addr_H %0
    $unL_start_addr_L %0
    $unL_start_addr_H %0
    $s_start_addr_L %0
    $s_start_addr_H %0
    $unS_start_addr_L %0
    $unS_start_addr_H %0

    $i %0
    $j %0

    ; IO Setter byte low        &DA58
    ; IO Setter byte high       &DA59
    ; IO ready flag             &DA5A
    ; p_stack                   &FF85
    ; RAM final address         &DA57
    ; Variable Memory           &D858

.data
_Decrement_Address
    ; Decrements the address stored in registers C (low) and D (high)
    DECR @C
    CMPI @C %255
    JZS #dec_high
    RSR

    #dec_high
        DECR @D
        RSR

_Increment_Address
    ; Increments the address stored in registers C (low) and D (high)
    INCR @C
    JZS #inc_high
    RSR

    #inc_high
        INCR @D
        RSR

_Increment_Aux_Address
    ; Shortcut subroutine to increment aux mem offset address
    LDFM @C $aux_offset_L
    LDFM @D $aux_offset_H
    JSR _Increment_Address
    STOR $aux_offset_L @C
    STOR $aux_offset_H @D
    RSR

_Grab_Low
    ; Load the aux mem offset address into the setter bytes of the IO
    COPM &DA58 $aux_offset_L
    COPM &DA59 $aux_offset_H
    STRI &DA5A %1 ; Sets the IO flag to let IO know to perform operations

    ; Get the lower byte value stored at the aux mem offset address
    COPM $low_byte &DA5B
    RSR

_Grab_High
    ; Load the aux mem offset address into the setter bytes of the IO
    COPM &DA58 $aux_offset_L
    COPM &DA59 $aux_offset_H
    STRI &DA5A %1

    ; Get the higher byte stores at the aux mem offset address
    COPM $high_byte &DA5C
    RSR

_Split_Bytes
    ; Load the aux mem offset address into the setter bytes of the IO
    COPM &DA58 $aux_offset_L
    COPM &DA59 $aux_offset_H
    STRI &DA5A %1

    ; Get the two bytes stored at the aux mem offset address
    COPM $low_byte &DA5B
    COPM $high_byte &DA5C
    JSR _Increment_Aux_Address
    RSR
    
_Grab_Byte
    ; Grabs the low byte if high_next is false, else grabs high byte
    ; In this subroutine, output is stored in low_byte
    LDFM @A $high_next
    JZS #grab_low

    ; Grab high byte
    JSR _Grab_High
    STRI $high_next %0
    COPM $low_byte $high_byte
    JSR _Increment_Aux_Address
    RSR

    #grab_low
        JSR _Grab_Low
        STRI $high_next %1
        RSR

_Grab_Word
    ; Grabs a word from aux mem offset address
    LDFM @A $high_next
    JZS #split

    ; The bytes to grab are in different addresses
    JSR _Grab_High
    JSR _Increment_Aux_Address
    JSR _Grab_Low
    SWPM $low_byte $high_byte
    RSR

    #split
        JSR _Split_Bytes
        RSR

_Check_Opcode_Type
    ; Given the opcode in $opcode, return a certain depending on what kind of encoding it is in register B
    LDFM @A $opcode
    LDFI @B %0

    ; If label jump opcode, (0x21, 0x24 - 0x2B)
    #lj_check
        CMPI @A %33
        JZS #is_lj

        CMPI @A %44
        JCS #sj_check
        CMPI @A %36
        JCS #is_lj

        JMP #sj_check

    #is_lj
        LDFI @B %1
        RSR

    ; If subroutine jump (0x22)
    #sj_check
        CMPI @A %34
        JZC #reg_op1_check

    #is_sj
        LDFI @B %2
        RSR

    ; If reg as op 1, (0x01 - 0x03, 0x05, 0x07, 0x08, 0x0E - 0x19, 0x1B, 0x1D, 0x1E, 0x38, 0x3C)
    #reg_op1_check
        CMPI @A %1
        JZS #is_reg_op1
        CMPI @A %2
        JZS #is_reg_op1
        CMPI @A %3
        JZS #is_reg_op1
        CMPI @A %5
        JZS #is_reg_op1
        CMPI @A %7
        JZS #is_reg_op1
        CMPI @A %8
        JZS #is_reg_op1
        CMPI @A %27
        JZS #is_reg_op1
        CMPI @A %29
        JZS #is_reg_op1
        CMPI @A %30
        JZS #is_reg_op1
        CMPI @A %56
        JZS #is_reg_op1
        CMPI @A %60
        JZS #is_reg_op1

        CMPI @A %26
        JCS #mem_op1_check
        CMPI @A %14
        JCS #is_reg_op1

        JMP #mem_op1_check

    #is_reg_op1
        LDFI @B %3
        JMP #reg_op2_check

    ; If mem as op 1, (0x04, 0x06, 0x09, 0x1A, 0x1C, 0x1F, 0x20, 0x39 - 0x3B, 0x3D - 0x40, 0x43 - 0x46)
    #mem_op1_check
        CMPI @A %4
        JZS #is_mem_op1
        CMPI @A %6
        JZS #is_mem_op1
        CMPI @A %9
        JZS #is_mem_op1
        CMPI @A %26
        JZS #is_mem_op1
        CMPI @A %28
        JZS #is_mem_op1
        CMPI @A %31
        JZS #is_mem_op1
        CMPI @A %32
        JZS #is_mem_op1

        CMPI @A %71
        JCS #reg_op2_check
        CMPI @A %67
        JCS #is_mem_op1
        CMPI @A %65
        JCS #reg_op2_check
        CMPI @A %61
        JCS #is_mem_op1
        CMPI @A %60
        JCS #reg_op2_check
        CMPI @A %57
        JCS #is_mem_op1

        JMP #reg_op2_check

    #is_mem_op1
        LDFI @B %4

    ; If reg as op 2, (0x03, 0x04, 0x05, 0x0E, 0x0F, 0x10, 0x12 - 0x16, 0x39)
    #reg_op2_check
        CMPI @A %3
        JZS #is_reg_op2
        CMPI @A %4
        JZS #is_reg_op2
        CMPI @A %5
        JZS #is_reg_op2
        CMPI @A %14
        JZS #is_reg_op2
        CMPI @A %15
        JZS #is_reg_op2
        CMPI @A %16
        JZS #is_reg_op2
        CMPI @A %57
        JZS #is_reg_op2

        CMPI @A %23
        JCS #mem_op2_check
        CMPI @A %18
        JCS #is_reg_op2

        JMP #mem_op2_check

    #is_reg_op2
        LDFI @A %2
        CCF
        ADD @B @A
        RSR

    ; If mem as op 2, (0x01, 0x06, 0x17, 0x38, 0x3A, 0x3C, 0x43, 0x44)
    #mem_op2_check
        CMPI @A %1
        JZS #is_mem_op2
        CMPI @A %6
        JZS #is_mem_op2
        CMPI @A %23
        JZS #is_mem_op2
        CMPI @A %56
        JZS #is_mem_op2
        CMPI @A %58
        JZS #is_mem_op2
        CMPI @A %60
        JZS #is_mem_op2
        CMPI @A %67
        JZS #is_mem_op2
        CMPI @A %68
        JZS #is_mem_op2

        JMP #imm_op2_check
    
    #is_mem_op2
        LDFI @A %4
        CCF
        ADD @B @A 
        RSR

    ; If imm as op 2, (0x02, 0x18, 0x45, 0x46)
    #imm_op2_check
        CMPI @A %2
        JZS #is_imm_op2
        CMPI @A %24
        JZS #is_imm_op2
        CMPI @A %69
        JZS #is_imm_op2
        CMPI @A %70
        JZS #is_imm_op2

        RSR

    #is_imm_op2
        LDFI @A %6
        CCF
        ADD @B @A 
        RSR

_start
    ; GET THE NUMBER OF VARIABLES 
    ; Get the first address from p_stack
    LDFM @E $p_stack_offset
    LDFI @F %0
    LDFO @A &FF85
    STOR $aux_offset_L @A
    INCR @E 

    LDFO @A &FF85
    STOR $aux_offset_H @A
    INCR @E
    STOR $p_stack_offset @E

    ; Increment given address by 2
    JSR _Increment_Aux_Address
    JSR _Increment_Aux_Address

    ; A word stores the size of var_size
    JSR _Grab_Word
    COPM $var_size_L $low_byte
    COPM $var_size_H $high_byte

    ; Store the first address of actual program in stack
    PSHM $aux_offset_H
    PSHM $aux_offset_L

    ; GET ENDING ADDRESS
    ; Get the second address from p_stack
    LDFM @E $p_stack_offset
    LDFI @F %0
    LDFO @A &FF85
    STOR $end_addr_L @A
    INCR @E

    LDFO @A &FF85
    STOR $end_addr_H @A
    INCR @E
    STOR $p_stack_offset @E

    ; GO TO THE FIRST ADDRESS OF .data SECTION
    #loop_start_1
        LDFM @A $var_size_L
        CMPM @A $i
        JZS #loop_end_1

        JSR _Grab_Word
        JSR _Grab_Byte

        INCM $i
        JMP #loop_start_1
    #loop_end_1

    ; 1ST LOOP TO GET SIZES OF MAPS
    #loop_start_2
        LDFM @A $end_addr_L
        CMPM @A $aux_offset_L
        JZC #loop_check_end

        LDFM @A $end_addr_H
        CMPM @A $aux_offset_H
        JZS #loop_end_2
        
        #loop_check_end
            ; Grab the next instruction
            JSR _Grab_Byte
            COPM $instruction $low_byte

        ; Check if the instruction is a label encoding (0x36, 54)
        #label_check_1
            LDFM @A $instruction 
            CMPI @A %54
            JZC #start_check_1
            
            INCM $l_size_L
            LDFM @A $l_size_L
            JZC #continue_1
            INCM $l_size_H

        #continue_1
            ; Skip the label id 
            JSR _Grab_Word
            JMP #loop_start_2

        ; Check if the instruction is a start encoding (0x37, 55)
        #start_check_1
            LDFM @A $instruction 
            CMPI @A %55
            JZC #subr_check_1

            ; Grab the next instruction and check for subroutine encoding 
            JSR _Grab_Byte
            COPM $instruction $low_byte

        ; Check if the instruction is a subroutine encoding (0x41, 65)
        #subr_check_1
            LDFM @A $instruction
            CMPI @A %65
            JZC #op_check_1

            INCM $s_size_L
            LDFM @A $s_size_L
            JZC #continue_2
            INCM $s_size_H

        #continue_2
            ; Skip the subroutine id
            JSR _Grab_Word
            JMP #loop_start_2

        ; Check opcode operands for any possible unL or unS values
        #op_check_1
            COPM $opcode $instruction

            ; Check what kind of opcode it is
            JSR _Check_Opcode_Type
            
            #label_value
                CMPI @B %1
                JZC #subr_value

                JSR _Grab_Word
                INCM $unL_size_L
                LDFM @A $unL_size_L
                JZC #loop_start_2
                INCM $unL_size_H
                JMP #loop_start_2

            #subr_value
                CMPI @B %2
                JZC #r_value

                JSR _Grab_Word
                INCM $unS_size_L
                LDFM @A $unS_size_L
                JZC #loop_start_2
                INCM $unS_size_H
                JMP #loop_start_2

            #r_value
                CMPI @B %3
                JZC #m_value

                JSR _Grab_Byte
                JMP #loop_start_2

            #m_value
                CMPI @B %4
                JZC #rr_value

                JSR _Grab_Byte
                JSR _Grab_Word
                JMP #loop_start_2

            #rr_value
                CMPI @B %5
                JZC #mr_value

                JSR _Grab_Word
                JMP #loop_start_2

            #mr_value
                CMPI @B %6
                JZC #rm_value

                JSR _Grab_Word
                JSR _Grab_Word
                JMP #loop_start_2

            #rm_value
                CMPI @B %7
                JZC #mm_value
                
                JSR _Grab_Word
                JSR _Grab_Word
                JMP #loop_start_2

            #mm_value
                CMPI @B %8
                JZC #ri_value

                JSR _Grab_Word
                JSR _Grab_Word
                JSR _Grab_Word
                JMP #loop_start_2

            #ri_value
                CMPI @B %9
                JZC #mi_value

                JSR _Grab_Word
                JMP #loop_start_2

            #mi_value
                CMPI @B %10
                JZC #loop_start_2

                JSR _Grab_Word
                JSR _Grab_Word
                JMP #loop_start_2
    #loop_end_2

    ; ALLOCATE SECTION OF MEMORY FOR THE MAPS AT THE END OF RAM
    ; Allocate l_size * 2 (2 bytes per label to store is address)
    LDFI @C %87 ; (0x57)
    LDFI @D %218 ; (0xDA)
    #l_alloc_loop_start
        LDFM @A $l_size_L
        JZC #loop_check_end_2
        LDFM @A $l_size_H
        JZS #l_alloc_loop_end

        #loop_check_end_2
            JSR _Decrement_Address
            JSR _Decrement_Address

            DECM $l_size_L
            LDFM @A $l_size_L
            CMPI @A %255
            JZC #l_alloc_loop_start
            DECM $l_size_H
            JMP #l_alloc_loop_start
    #l_alloc_loop_end
    STOR $l_start_addr_L @C
    STOR $l_start_addr_H @D

    ; Allocate unL_size * 4 (2 bytes to store id, 2 to store address)
    #unL_alloc_loop_start
        LDFM @A $unL_size_L
        JZC #loop_check_end_3
        LDFM @A $unL_size_H
        JZS #unL_alloc_loop_end

        #loop_check_end_3
            JSR _Decrement_Address
            JSR _Decrement_Address
            JSR _Decrement_Address
            JSR _Decrement_Address

            DECM $unL_size_L
            LDFM @A $unL_size_L
            CMPI @A %255
            JZC #unL_alloc_loop_start
            DECM $unL_size_H
            JMP #unL_alloc_loop_start
    #unL_alloc_loop_end
    STOR $unL_start_addr_L @C
    STOR $unL_start_addr_H @D

    ; Allocate s_size * 2 (2 bytes to store its address)
    #s_alloc_loop_start
        LDFM @A $s_size_L
        JZC #loop_check_end_4
        LDFM @A $s_size_H
        JZS #s_alloc_loop_end

        #loop_check_end_4
            JSR _Decrement_Address
            JSR _Decrement_Address

            DECM $s_size_L
            LDFM @A $s_size_L
            CMPI @A %255
            JZC #s_alloc_loop_start
            DECM $s_size_H
            JMP #s_alloc_loop_start
    #s_alloc_loop_end
    STOR $s_start_addr_L @C
    STOR $s_start_addr_H @D

    ; Allocate unS_size * 4  (2 bytes to store its address, 2 bytes to store id)
    #unS_alloc_loop_start
        LDFM @A $unS_size_L
        JZC #loop_check_end_5
        LDFM @A $unS_size_H
        JZS #unS_alloc_loop_end

        #loop_check_end_5
            JSR _Decrement_Address
            JSR _Decrement_Address
            JSR _Decrement_Address
            JSR _Decrement_Address

            DECM $unS_size_L
            LDFM @A $unS_size_L
            CMPI @A %255
            JZC #unS_alloc_loop_start
            DECM $unS_size_H
            JMP #unS_alloc_loop_start
    #unS_alloc_loop_end
    STOR $unS_start_addr_L @C
    STOR $unS_start_addr_H @D

    ; Go back to first address of variables to start second loop
    PULR @A
    STOR $aux_offset_L @A
    PULR @A
    STOR $aux_offset_H @A
    STRI $high_next %0

    ; 2ND LOOP TO PARSE CONTENT
    #loop_start_3
        LDFM @A $end_addr_L
        CMPM @A $aux_offset_L
        JZC #loop_check_end_6

        LDFM @A $end_addr_H
        CMPM @A $aux_offset_H
        JZS #loop_end_3

        #loop_check_end_6
            ; Parse a variable if var_count != 0
            LDFM @A $var_size_L
            JZC #get_var_value

            LDFM @A $var_size_H
            JZS #instruction_grab

        #get_var_value
            JSR _Grab_Word
            JSR _Grab_Byte

            LDFM @E $var_offset_L
            LDFM @F $var_offset_H
            LDFI @C %0
            LDFI @D %0
            COPO &D858 $low_byte
            
            INCM $var_offset_L
            LDFM @A $var_offset_L
            JZC #var_count_minus
            INCM $var_offset_H

            #var_count_minus
                LDFM @A $var_size_L
                JZC #minus_L
                DECM $var_size_H

            #minus_L
                DECM $var_size_L

            JMP #loop_start_3
            
        #instruction_grab
            JSR _Grab_Byte
            COPM $instruction $low_byte

        ; Check if it is a halt instruction (0x35)
        #halt_check
            LDFM @A $instruction
            CMPI @A %53
            JZC #label_check_2

            LDFM @A $pc_set
            JZS #write_halt_to_memory
            COPM $pc_start_addr_L $RAM_offset_L
            COPM $pc_start_addr_H $RAM_offset_H
            STRI $pc_set %1

            #write_halt_to_memory
                LDFI @C %0
                LDFI @D %0
                LDFM @E $RAM_offset_L
                LDFM @F $RAM_offset_H
                COPO &0100 $instruction
                LDFM @C $RAM_offset_L
                LDFM @D $RAM_offset_H
                JSR _Increment_Address
                STOR $RAM_offset_L @C
                STOR $RAM_offset_H @D
                
            
            JMP #loop_start_3

        ; Check if the is a label encoding (0x36)
        #label_check_2
            CMPI @A %54
            JZC #subr_check_2

            ; Grab the label id
            JSR _Grab_Word

            ; Prepare the offsets to store address of label
            LDFI @C %0
            LDFI @D %0
            LDFM @E $l_start_addr_L
            LDFM @F $l_start_addr_H

            ; Decrement id to get position in map / array
            LDFM @A $low_byte
            LDFM @B $high_byte
            DECR @A
            CMPI @A %255
            JSC #move_to_addr_1
            DECR @B

            ; increment @E and @F to move offset to correct spot 
            #move_to_addr_1
                CMPI @A %0
                JZC #inc_1
                CMPI @B %0
                JZS #first_addr_store

                #inc_1
                    DECR @A
                    CMPI @A %255
                    JSC #low_byte_inc
                    DECR @B

                    #low_byte_inc
                    INCR @E 
                    JZC #inc_2
                    INCR @F

                #inc_2
                    INCR @E 
                    JZC #move_to_addr_1
                    INCR @F
                    JMP #move_to_addr_1

            ; store RAM_offset in set position
            #first_addr_store
                COPO &0000 $RAM_offset_L
                INCR @E
                JZC #second_addr_store
                INCR @F

            #second_addr_store
                COPO &0000 $RAM_offset_H

            ; Loop through unL map
            #loop_start_4_prep
                LDFM @A $low_byte
                LDFM @B $high_byte
                LDFM @E $unL_start_addr_L
                LDFM @F $unL_start_addr_H

            #loop_start_4
                CMPM @E $l_start_addr_L
                JZC #check_id
                CMPM @F $l_start_addr_H
                JZS #loop_end_4

                #check_id
                    CMPO @A &0000                    
                    JZC #id_nq_1
                    INCR @E
                    JZC #high_byte_check
                    INCR @F
                    
                #high_byte_check
                    CMPO @B &0000
                    JZC #id_nq_1
                    INCR @E
                    JZC #get_addr_low
                    INCR @F

                #get_addr_low
                    LDFO @A &0000
                    INCR @E
                    JZC #get_addr_high
                    INCR @F

                #get_addr_high
                    LDFO @B &0000
                    INCR @E
                    JZC #store_id_addr_low
                    INCR @F

                #store_id_addr_low
                    PSHR @F
                    PSHR @E

                    LDFR @E @A
                    LDFR @F @B

                    LDFI @A %1
                    CCF                    
                    ADD @F @A

                    LDFM @C $RAM_offset_L
                    LDFM @D $RAM_offset_H
                    CCF 
                    ADD @D @A

                    STOO &0000 @C

                    INCR @E
                    JZC #store_id_addr_high
                    INCR @F

                #store_id_addr_high
                    STOO &0000 @D
                    PULR @E
                    PULR @F
                    LDFM @A $low_byte
                    LDFM @B $high_byte

                    JMP #loop_start_4


                ; id not equal, skip 4 bytes to go to next id
                #id_nq_1
                    INCR @E
                    JZC #id_nq_2
                    INCR @F

                #id_nq_2
                    INCR @E
                    JZC #id_nq_3
                    INCR @F

                #id_nq_3
                    INCR @E
                    JZC #id_nq_4
                    INCR @F

                #id_nq_4
                    INCR @E
                    JZC #loop_start_4
                    INCR @F
                    JMP #loop_start_4
            #loop_end_4

            JMP #loop_start_3

        ; Check if the is a subroutine encoding (0x41)
        #subr_check_2
            CMPI @A %65
            JZC #start_check

            ; Grab the label id
            JSR _Grab_Word

            ; Prepare the offsets to store address of label
            LDFI @C %0
            LDFI @D %0
            LDFM @E $s_start_addr_L
            LDFM @F $s_start_addr_H

            ; Decrement id to get position in map / array
            LDFM @A $low_byte
            LDFM @B $high_byte
            DECR @A
            CMPI @A %255
            JSC #move_to_addr_2
            DECR @B

            ; increment @E and @F to move offset to correct spot 
            #move_to_addr_2
                CMPI @A %0
                JZC #inc_3
                CMPI @B %0
                JZS #first_addr_store_1

                #inc_3
                    DECR @A
                    CMPI @A %255
                    JSC #low_byte_inc_1
                    DECR @B

                    #low_byte_inc_1
                    INCR @E 
                    JZC #inc_4
                    INCR @F

                #inc_4
                    INCR @E 
                    JZC #move_to_addr_2
                    INCR @F
                    JMP #move_to_addr_2

            ; store RAM_offset in set position
            #first_addr_store_1
                COPO &0000 $RAM_offset_L
                INCR @E
                JZC #second_addr_store_2
                INCR @F

            #second_addr_store_2
                COPO &0000 $RAM_offset_H

            ; Loop through unS map
            #loop_start_4_prep_1
                LDFM @A $low_byte
                LDFM @B $high_byte
                LDFM @E $unS_start_addr_L
                LDFM @F $unS_start_addr_H

            #loop_start_5
                CMPM @E $s_start_addr_L
                JZC #check_id_1
                CMPM @F $s_start_addr_H
                JZS #loop_end_5

                #check_id_1
                    CMPO @A &0000                    
                    JZC #id_nq_1_1
                    INCR @E
                    JZC #high_byte_check_1
                    INCR @F
                    
                #high_byte_check_1
                    CMPO @B &0000
                    JZC #id_nq_1_1
                    INCR @E
                    JZC #get_addr_low_1
                    INCR @F

                #get_addr_low_1
                    LDFO @A &0000
                    INCR @E
                    JZC #get_addr_high_1
                    INCR @F

                #get_addr_high_1
                    LDFO @B &0000
                    INCR @E
                    JZC #store_id_addr_low_1
                    INCR @F

                #store_id_addr_low_1
                    PSHR @F
                    PSHR @E

                    LDFR @E @A
                    LDFR @F @B

                    LDFI @A %1
                    CCF                    
                    ADD @F @A

                    LDFM @C $RAM_offset_L
                    LDFM @D $RAM_offset_H
                    CCF 
                    ADD @D @A

                    STOO &0000 @C

                    INCR @E
                    JZC #store_id_addr_high_1
                    INCR @F

                #store_id_addr_high_1
                    STOO &0000 @D
                    PULR @E
                    PULR @F
                    LDFM @A $low_byte
                    LDFM @B $high_byte

                    JMP #loop_start_5


                ; id not equal, skip 4 bytes to go to next id
                #id_nq_1_1
                    INCR @E
                    JZC #id_nq_2_1
                    INCR @F

                #id_nq_2_1
                    INCR @E
                    JZC #id_nq_3_1
                    INCR @F

                #id_nq_3_1
                    INCR @E
                    JZC #id_nq_4_1
                    INCR @F

                #id_nq_4_1
                    INCR @E
                    JZC #loop_start_5
                    INCR @F
                    JMP #loop_start_5
            #loop_end_5

            JMP #loop_start_3

        ; Check if it a start encoding (0x37)
        #start_check
            LDFM @A $instruction
            CMPI @A %55
            JZC #pc_set_check

            COPM $pc_start_addr_L $RAM_offset_L
            COPM $pc_start_addr_H $RAM_offset_H
            STRI $pc_set %1
            
            JMP #loop_start_3

        ; Update the start of the program if either a halt or a start instruction has not yet appeared
        #pc_set_check
            LDFM @A $pc_set
            JZC #ins_to_op

            COPM $pc_start_addr_L $RAM_offset_L
            COPM $pc_start_addr_H $RAM_offset_H
            STRI $pc_set %1

        #ins_to_op
            LDFI @C %0
            LDFI @D %0
            LDFM @E $RAM_offset_L
            LDFM @F $RAM_offset_H
            COPO &0100 $instruction

            LDFR @C @E 
            LDFR @D @F
            JSR _Increment_Address
            STOR $RAM_offset_L @C
            STOR $RAM_offset_H @D

            COPM $opcode $instruction

            JSR _Check_Opcode_Type

        #label_value_2
            CMPI @B %1
            JZC #subr_value_2
            JSR _Grab_Word

            LDFM @E $l_start_addr_L
            LDFM @F $l_start_addr_H

            LDFM @A $low_byte
            LDFM @B $high_byte
            DECR @A
            CMPI @A %255
            JZC #add_1
            DECR @B
            
            #add_1
            CCF
            ADD @E @A
            JOC #add_2
            INCR @F

            #add_2
            CCF
            ADD @F @B
            CCF
            ADD @E @A
            JOC #add_3
            INCR @F

            #add_3
            CCF
            ADD @F @B

            #get_label_addr_1
            LDFO @A &0000
            INCR @E 
            JZC #get_label_addr_2
            INCR @F

            #get_label_addr_2
            LDFO @B &0000

            ; If the label address is 0, write the label to unL
            CMPR @A @B 
            JZC #write_label_to_memory
            CMPI @A %0
            JZC #write_label_to_memory

            LDFI @C %0
            LDFI @D %0
            LDFM @E $unL_start_addr_L
            LDFM @F $unL_start_addr_H

            LDFM @A $unL_offset_L
            LDFM @B $unL_offset_H
            CCF
            ADD @E @A
            JOC #add_4
            INCR @F

            #add_4
            CCF
            ADD @F @B

            COPO &0000 $low_byte
            INCR @E 
            JZC #inc_unL_offset_1
            INCR @F

            #inc_unL_offset_1
                INCR @A
                JZC #copy_high_byte
                INCR @B

            #copy_high_byte
                COPO &0000 $high_byte
                INCR @E 
                JZC #inc_unL_offset_2
                INCR @F

            #inc_unL_offset_2
                INCR @A
                JZC #copy_addr_low
                INCR @B

            #copy_addr_low
                COPO &0000 $RAM_offset_L
                INCR @E 
                JZC #inc_unL_offset_3
                INCR @F

            #inc_unL_offset_3
                INCR @A
                JZC #copy_addr_high
                INCR @B

            #copy_addr_high
                COPO &0000 $RAM_offset_H
                INCR @A
                JZC #store_offset
                INCR @B

            #store_offset
            STOR $unL_offset_L @A
            STOR $unL_offset_H @B

            LDFM @C $RAM_offset_L
            LDFM @D $RAM_offset_H
            JSR _Increment_Address
            JSR _Increment_Address
            STOR $RAM_offset_L @C
            STOR $RAM_offset_H @D

            JMP #loop_start_3

            #write_label_to_memory
            LDFR @C @A
            LDFR @D @B
            LDFM @E $RAM_offset_L
            LDFM @F $RAM_offset_H
            
            STOO &0100 @A
            INCR @E 
            JZC #store_high
            INCR @F

            #store_high
                STOO &0100 @B

            LDFM @C $RAM_offset_L
            LDFM @D $RAM_offset_H
            JSR _Increment_Address
            JSR _Increment_Address
            STOR $RAM_offset_L @C
            STOR $RAM_offset_H @D

            JMP #loop_start_3

        #subr_value_2
            CMPI @B %2
            JZC #r_value_2
            JSR _Grab_Word

            LDFM @E $l_start_addr_L
            LDFM @F $l_start_addr_H

            LDFM @A $low_byte
            LDFM @B $high_byte
            DECR @A
            CMPI @A %255
            JZC #add_1_1
            DECR @B
            
            #add_1_1
            CCF
            ADD @E @A
            JOC #add_2_1
            INCR @F

            #add_2_1
            CCF
            ADD @F @B
            CCF
            ADD @E @A
            JOC #add_3_1
            INCR @F

            #add_3_1
            CCF
            ADD @F @B

            #get_label_addr_1_1
            LDFO @A &0000
            INCR @E 
            JZC #get_label_addr_2_1
            INCR @F

            #get_label_addr_2_1
            LDFO @B &0000

            ; If the label address is 0, write the label to unL
            CMPR @A @B 
            JZC #write_label_to_memory_1
            CMPI @A %0
            JZC #write_label_to_memory_1

            LDFI @C %0
            LDFI @D %0
            LDFM @E $unL_start_addr_L
            LDFM @F $unL_start_addr_H

            LDFM @A $unL_offset_L
            LDFM @B $unL_offset_H
            CCF
            ADD @E @A
            JOC #add_4_1
            INCR @F

            #add_4_1
            CCF
            ADD @F @B

            COPO &0000 $low_byte
            INCR @E 
            JZC #inc_unL_offset_1_1
            INCR @F

            #inc_unL_offset_1_1
                INCR @A
                JZC #copy_high_byte_1
                INCR @B

            #copy_high_byte_1
                COPO &0000 $high_byte
                INCR @E 
                JZC #inc_unL_offset_2_1
                INCR @F

            #inc_unL_offset_2_1
                INCR @A
                JZC #copy_addr_low_1
                INCR @B

            #copy_addr_low_1
                COPO &0000 $RAM_offset_L
                INCR @E 
                JZC #inc_unL_offset_3_1
                INCR @F

            #inc_unL_offset_3_1
                INCR @A
                JZC #copy_addr_high_1
                INCR @B

            #copy_addr_high_1
                COPO &0000 $RAM_offset_H
                INCR @A
                JZC #store_offset_1
                INCR @B

            #store_offset_1
            STOR $unL_offset_L @A
            STOR $unL_offset_H @B

            LDFM @C $RAM_offset_L
            LDFM @D $RAM_offset_H
            JSR _Increment_Address
            JSR _Increment_Address
            STOR $RAM_offset_L @C
            STOR $RAM_offset_H @D

            JMP #loop_start_3

            #write_label_to_memory_1
            LDFR @C @A
            LDFR @D @B
            LDFM @E $RAM_offset_L
            LDFM @F $RAM_offset_H
            
            STOO &0100 @A
            INCR @E 
            JZC #store_high_1
            INCR @F

            #store_high_1
                STOO &0100 @B

            LDFM @C $RAM_offset_L
            LDFM @D $RAM_offset_H
            JSR _Increment_Address
            JSR _Increment_Address
            STOR $RAM_offset_L @C
            STOR $RAM_offset_H @D

            JMP #loop_start_3

        #r_value_2
            CMPI @B %3
            JZC #m_value_2
            JSR _Grab_Byte

            LDFI @C %0
            LDFI @D %0
            LDFM @E $RAM_offset_L
            LDFM @F $RAM_offset_H

            COPO &0100 $low_byte
        
            LDFM @C $RAM_offset_L
            LDFM @D $RAM_offset_H
            JSR _Increment_Address
            STOR $RAM_offset_L @C
            STOR $RAM_offset_H @D

            JMP #loop_start_3

        #m_value_2
            CMPI @B %4
            JZC #rr_value_2
            JSR _Grab_Byte

            ; Check if instruction is an address encoding
            LDFI @A %66
            CMPM @A $low_byte
            JZC #no_address

            JSR _Grab_Word
            LDFI @C %0
            LDFI @D %0
            LDFM @E $RAM_offset_L
            LDFM @F $RAM_offset_H

            COPO &0100 $low_byte
            LDFM @C $RAM_offset_L
            LDFM @D $RAM_offset_H
            JSR _Increment_Address

            LDFR @E @C
            LDFR @F @D
            LDFI @C %0
            LDFI @D %0

            COPO &0100 $high_byte
            LDFM @C $RAM_offset_L
            LDFM @D $RAM_offset_H
            JSR _Increment_Address

            STOR $RAM_offset_L @C
            STOR $RAM_offset_H @D
            JMP #loop_start_3

            #no_address
                JSR _Grab_Word
                LDFM @C $low_byte
                LDFM @D $high_byte
                DECR @C
                CMPI @C %255
                JZC #add_addr_1
                DECR @D

            #add_addr_1
                LDFI @B %88
                CCF
                ADD @C @B
                JOC #add_addr_2
                INCR @D

            #add_addr_2
                LDFI @B %216
                CCF
                ADD @D @B

            LDFM @E $RAM_offset_L
            LDFM @F $RAM_offset_H
            STOO &0100 @C

            INCR @E 
            JZC #stor_addr_high
            INCR @F

            #stor_addr_high
                STOO &0100 @D
                LDFR @C @E
                LDFR @D @F
                JSR _Increment_Address

            STOR $RAM_offset_L @C
            STOR $RAM_offset_H @D
            JMP #loop_start_3

        #rr_value_2
            CMPI @B %5
            JZC #mr_value_2
            JSR _Grab_Byte

            LDFI @C %0
            LDFI @D %0
            LDFM @E $RAM_offset_L
            LDFM @F $RAM_offset_H

            COPO &0100 $low_byte

            JSR _Grab_Byte

            LDFM @C $RAM_offset_L
            LDFM @D $RAM_offset_H
            JSR _Increment_Address
            LDFR @E @C
            LDFR @F @D
            LDFI @C %0
            LDFI @D %0

            COPO &0100 $low_byte
        
            LDFM @C $RAM_offset_L
            LDFM @D $RAM_offset_H
            JSR _Increment_Address
            STOR $RAM_offset_L @C
            STOR $RAM_offset_H @D

            JMP #loop_start_3

        #mr_value_2
            CMPI @B %6
            JZC #rm_value_2
            JSR _Grab_Byte

            ; Check if instruction is an address encoding
            LDFI @A %66
            CMPM @A $low_byte
            JZC #no_address_1

            JSR _Grab_Word
            LDFI @C %0
            LDFI @D %0
            LDFM @E $RAM_offset_L
            LDFM @F $RAM_offset_H

            COPO &0100 $low_byte
            LDFM @C $RAM_offset_L
            LDFM @D $RAM_offset_H
            JSR _Increment_Address

            LDFR @E @C
            LDFR @F @D
            LDFI @C %0
            LDFI @D %0

            COPO &0100 $high_byte
            LDFM @C $RAM_offset_L
            LDFM @D $RAM_offset_H
            JSR _Increment_Address

            STOR $RAM_offset_L @C
            STOR $RAM_offset_H @D
            JMP #reg_as_op2_1

            #no_address_1
                JSR _Grab_Word
                LDFM @C $low_byte
                LDFM @D $high_byte
                DECR @C
                CMPI @C %255
                JZC #add_addr_1_1
                DECR @D

            #add_addr_1_1
                LDFI @B %88
                CCF
                ADD @C @B
                JOC #add_addr_2_1
                INCR @D

            #add_addr_2_1
                LDFI @B %216
                CCF
                ADD @D @B

            LDFM @E $RAM_offset_L
            LDFM @F $RAM_offset_H
            STOO &0100 @C

            INCR @E 
            JZC #stor_addr_high_1
            INCR @F

            #stor_addr_high_1
                STOO &0100 @D
                LDFR @C @E
                LDFR @D @F
                JSR _Increment_Address

            STOR $RAM_offset_L @C
            STOR $RAM_offset_H @D
        
            #reg_as_op2_1
                JSR _Grab_Byte

                LDFI @C %0
                LDFI @D %0
                LDFM @E $RAM_offset_L
                LDFM @F $RAM_offset_H

                COPO &0100 $low_byte
            
                LDFM @C $RAM_offset_L
                LDFM @D $RAM_offset_H
                JSR _Increment_Address
                STOR $RAM_offset_L @C
                STOR $RAM_offset_H @D

                JMP #loop_start_3

        #rm_value_2
            CMPI @B %7
            JZC #mm_value_2

            JSR _Grab_Byte

            LDFI @C %0
            LDFI @D %0
            LDFM @E $RAM_offset_L
            LDFM @F $RAM_offset_H

